rules_version = '2';

// Zero-Trust Security Configuration for AMIE (AmCham's Intelligent Employee Assistant)
// AMIE uses an authoritative server-side architecture where Cloud Firestore is accessed
// exclusively by the Node.js/Express API server via the Firebase Admin SDK using a service account.
// All role-based access control (RBAC), PBKDF2 password verification, session token checks,
// and audit logging are strictly enforced in the API layer.
// Direct public client access is completely disabled to guarantee zero data leakage and prevent
// 30-day "test mode" expiration failures from ever impacting the live application.

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all direct client access; backend server connects with administrative credentials
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
